local function StartServerHop()
	if ServerSearching then
		ServerSearching = false
		HideHopLoadingScreen()
		SetServerHopIdle()
		return
	end

	ServerSearching = true
	LastTeleportState = nil
	ShowHopLoadingScreen("Procurando servidor ideal...")

	ServerHopTitle.Text = 'STOP <font color="rgb(57,255,20)">SEARCHING</font>'
	ServerHopTitle.TextColor3 = GREEN_LIGHT
	ServerHopStatus.Text = 'Status: <font color="rgb(57,255,20)">aguardando - prioridade 2 Player > 1 Player</font>'
	ServerHopStatus.TextColor3 = GREEN_LIGHT

	TweenService:Create(ServerHopButton, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {
		BackgroundColor3 = Color3.fromRGB(27, 68, 38)
	}):Play()

	TweenService:Create(ServerHopStroke, TweenInfo.new(0.18), {
		Color = NEON_GREEN
	}):Play()

	task.spawn(function()
		local attempt = 1

		while ServerSearching do
			SetHopFeedback(
				'STOP <font color="rgb(57,255,20)">SEARCHING</font>',
				string.format("Status: escaneando servidores... (#%d)", attempt),
				GREEN_LIGHT,
				GREEN_LIGHT
			)

			local foundJobId, playerCount = FindLowestTailServer()

			if foundJobId then
				_G.HzsBlacklist[foundJobId] = true
				_G.HzsServerBlacklist[foundJobId] = true
				LastTeleportState = nil

				SetHopFeedback(
					"JOINING...",
					string.format("Status: %dP encontrado - entrando...", playerCount or 0),
					NEON_GREEN,
					GREEN_LIGHT
				)

				ShowHopLoadingScreen(string.format("Servidor com %d jogador(es) encontrado!", playerCount or 0))
				task.wait(0.05)

				local failed = false
				local failConn
				failConn = TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
					if player ~= LocalPlayer then
						return
					end

					failed = true
					_G.HzsBlacklist[foundJobId] = true
					_G.HzsServerBlacklist[foundJobId] = true

					if failConn then
						failConn:Disconnect()
						failConn = nil
					end

					HideHopLoadingScreen()

					local reason = teleportResult and teleportResult.Name or "Unknown"
					if errorMessage and tostring(errorMessage) ~= "" then
						reason = reason .. ": " .. tostring(errorMessage)
					end

					if ServerSearching then
						if teleportResult == Enum.TeleportResult.GameFull
							or string.find(string.lower(reason), "full", 1, true) then
							SetHopFeedback(
								"PROCURANDO OUTRO",
								"Status: server lotou - procurando outro...",
								GREEN_LIGHT,
								GREEN_LIGHT
							)
						else
							SetHopFeedback(
								"SERVER HOP FALHOU",
								"Status: " .. reason .. " - tentando novamente...",
								Color3.fromRGB(57, 255, 20),
								Color3.fromRGB(145, 255, 120)
							)
						end
					end
				end)

				local teleportOk, teleportError = pcall(function()
					TeleportService:TeleportToPlaceInstance(PlaceId, foundJobId, LocalPlayer)
				end)

				if not teleportOk then
					failed = true
					HideHopLoadingScreen()
					if failConn then
						failConn:Disconnect()
						failConn = nil
					end
					SetHopFeedback(
						'SERVER <font color="rgb(57,255,20)">HOP FALHOU</font>',
						"Status: falhou ao iniciar - " .. tostring(teleportError),
						Color3.fromRGB(57, 255, 20),
						Color3.fromRGB(145, 255, 120)
					)
				else
					local waitStarted = os.clock()
					while ServerSearching and not failed and os.clock() - waitStarted < 5 do
						if LastTeleportState == Enum.TeleportState.Started
							or LastTeleportState == Enum.TeleportState.WaitingForServer
							or LastTeleportState == Enum.TeleportState.InProgress then
							break
						end
						task.wait(0.1)
					end

					if not failed
						and LastTeleportState ~= Enum.TeleportState.Started
						and LastTeleportState ~= Enum.TeleportState.WaitingForServer
						and LastTeleportState ~= Enum.TeleportState.InProgress then
						HideHopLoadingScreen()
						SetHopFeedback(
							"SERVER HOP FALHOU",
							"Status: teleporte não iniciou - tentando outro...",
							Color3.fromRGB(57, 255, 20),
							Color3.fromRGB(145, 255, 120)
						)
					end
				end

				if failConn then
					failConn:Disconnect()
					failConn = nil
				end

				if ServerSearching and failed then
					task.wait(0.5)
				end
			else
				SetHopFeedback(
					"STOP SEARCHING",
					string.format("Status: nenhum servidor ideal - retry #%d", attempt),
					GREEN_LIGHT,
					SUBTEXT
				)
				task.wait(0.3)
			end

			if ServerSearching then
				attempt += 1
				task.wait(0.1)
			end
		end

		HideHopLoadingScreen()
		SetServerHopIdle()
	end)
end

