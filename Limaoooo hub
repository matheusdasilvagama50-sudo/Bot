local function CreateFakeAndTeleportReal()
	local Character = LocalPlayer.Character
	if not Character then
		return
	end

	local RootPart = Character:FindFirstChild("HumanoidRootPart")
	local RealHumanoid = Character:FindFirstChildOfClass("Humanoid")
	if not RootPart or not RealHumanoid then
		return
	end

	local OriginalCFrame = RootPart.CFrame
	Character.Archivable = true

	local CloneOk, FakeCharacter = pcall(function()
		return Character:Clone()
	end)

	Character.Archivable = false
	if not CloneOk or not FakeCharacter then
		return
	end

	FakeCharacter.Name = "FakeVisualPlayer"

	for _, Descendant in ipairs(FakeCharacter:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			Descendant.CanCollide = false
			Descendant.Anchored = true
		elseif Descendant:IsA("Script") or Descendant:IsA("LocalScript") then
			Descendant:Destroy()
		end
	end

	FakeCharacter.Parent = Workspace
	FakeCharacter:PivotTo(OriginalCFrame)

	local CurrentCamera = Workspace.CurrentCamera
	local FakeHumanoid = FakeCharacter:FindFirstChildOfClass("Humanoid")

	if FakeHumanoid and CurrentCamera then
		CurrentCamera.CameraSubject = FakeHumanoid
	end

	local TargetCFrame = CFrame.new(TARGET_POS + Vector3.new(0, 3, 0))
	local StartTime = os.clock()
	local HoldConnection

	HoldConnection = RunService.Heartbeat:Connect(function()
		if not AntiHitEnabled or not Character.Parent or not RootPart.Parent then
			if HoldConnection then
				HoldConnection:Disconnect()
			end
			return
		end

		RootPart.AssemblyLinearVelocity = Vector3.zero
		RootPart.AssemblyAngularVelocity = Vector3.zero
		RootPart.CFrame = TargetCFrame
		Character:PivotTo(TargetCFrame)

		if os.clock() - StartTime >= 0.6 then
			HoldConnection:Disconnect()
		end
	end)

	task.delay(0.6, function()
		if HoldConnection then
			pcall(function()
				HoldConnection:Disconnect()
			end)
		end

		if FakeCharacter and FakeCharacter.Parent then
			FakeCharacter:Destroy()
		end

		if RealHumanoid and RealHumanoid.Parent and CurrentCamera then
			CurrentCamera.CameraSubject = RealHumanoid
		end
	end)
end

local function TriggerAntiHit()
	if AntiHitRunning or not AntiHitEnabled then
		return
	end

	AntiHitRunning = true
	task.wait(0.1)

	local Character = LocalPlayer.Character
	if Character then
		for _, Item in ipairs(Character:GetChildren()) do
			if Item:IsA("Tool") then
				Item.Parent = Workspace
			end
		end

		CreateFakeAndTeleportReal()
	end

	task.delay(0.8, function()
		AntiHitRunning = false
	end)
end

local function SetupCharacterDetection(Character)
	if CharacterDetectionConnection then
		CharacterDetectionConnection:Disconnect()
		CharacterDetectionConnection = nil
	end

	if not Character then
		return
	end

	CharacterDetectionConnection = Character.ChildAdded:Connect(function(Child)
		if not AntiHitEnabled or Child:IsA("Tool") then
			return
		end

		local Name = string.lower(Child.Name)
		if string.find(Name, "egg") or string.find(Name, "telur") then
			task.spawn(TriggerAntiHit)
		end
	end)
end

if LocalPlayer.Character then
