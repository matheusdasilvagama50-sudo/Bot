local function UpdateScale()
	local Viewport = Camera.ViewportSize

	local Scale = 1

	if Viewport.X <= 500 then
		Scale = 0.72
	elseif Viewport.X <= 650 then
		Scale = 0.80
	elseif Viewport.X <= 800 then
		Scale = 0.88
	elseif Viewport.X <= 1000 then
		Scale = 0.94
	end

	TargetUiScale = Scale
	if IntroFinished then
		ContainerScale.Scale = TargetUiScale
	end
