local function StartLimaoFirebaseBroadcastListener()
	local G = (type(getgenv) == "function" and getgenv()) or _G
	local state = G._limaohub_antihit_broadcastState
	if type(state) ~= "table" then
		state = {}
		G._limaohub_antihit_broadcastState = state
	end

	state.listenerToken = (state.listenerToken or 0) + 1
	local myToken = state.listenerToken
	local lastMessageKey = tostring(state.lastMessageKey or "")
	local initialized = false

	task.spawn(function()
		while state.listenerToken == myToken do
			task.wait(1)

			local res = LimaoBroadcastHttpReq({
				Url = LIMAOHUB_FIREBASE_URL .. "/hzshub_admin/broadcast.json",
				Method = "GET",
				Headers = { ["Content-Type"] = "application/json" }
			})

			if state.listenerToken ~= myToken then
				return
			end

			if res and res.Body and res.Body ~= "null" then
				local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
				if ok and type(data) == "table" and data.active and (data.id or data.timestamp) then
					local messageKey = tostring(data.id or data.timestamp)

					if not initialized then
						initialized = true
						if lastMessageKey ~= "" then
							state.lastMessageKey = lastMessageKey
						end
						if messageKey ~= lastMessageKey then
							lastMessageKey = messageKey
							state.lastMessageKey = messageKey
						end
					elseif messageKey ~= "" and messageKey ~= lastMessageKey then
						lastMessageKey = messageKey
						state.lastMessageKey = messageKey
						ShowLimaoFirebaseBroadcast(data)
					end
				end
			end
		end
	end)
end

