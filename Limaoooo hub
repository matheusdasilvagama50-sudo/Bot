local function LimaoBroadcastHttpReq(options)
	local fn = (syn and syn.request)
		or (http and http.request)
		or http_request
		or (fluxus and fluxus.request)
		or request
	if fn then
		local ok, res = pcall(fn, options)
		if ok and res then
			return res
		end
	end

	if type(options) == "table" and tostring(options.Method or "GET"):upper() == "GET" then
		local ok, body = pcall(function()
			return game:HttpGet(options.Url)
		end)
		if ok and type(body) == "string" then
			return {Body = body, StatusCode = 200}
		end
	end

	return nil
end

